# SpotFinder Production Keystore Configuration Template
# 1. Generate an upload keystore:
#    keytool -genkey -v -keystore spotfinder-upload-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# 2. Copy this file to android/key.properties
# 3. Fill in your passwords and file path below:

keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD_HERE
storeFile=../spotfinder-upload-key.jks
storePassword=YOUR_STORE_PASSWORD_HERE

